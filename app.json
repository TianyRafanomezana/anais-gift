{
  "expo": {
    "name": "Brand New Heart",
    "slug": "Brand-New-Heart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/white-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/white-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/white-icon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-font"
    ]
  }
}
